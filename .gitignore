# Recordings and tracking exports. These are unpublished experiment data and
# some run to tens of megabytes, so they stay local. Use "git add -f" if you
# ever deliberately want to commit one.
*.csv
*.slp
*.h5
*.hdf5
*.pkl
*.mp4
*.avi
*.mov
*.mkv

# Frames pulled out of the recordings, and anything the review script renders
modelTongueSample*.PNG
modelTongueSample*.png
review_*.png
*_diagnostics.png

# Hand scoring workspace. Holds exported video frames and the scores derived from
# them, so it is unpublished experiment data like everything else above.
handscore/

# Script output
*_anticipatory_licks.csv
*_anticipatory_bouts.csv
*_lick_bouts.csv
*_trials.csv
*_frames_annotated.csv
combined_session_summary.csv
scratch*/
out/
output/
results/

